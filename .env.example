# Gemini API Key (NecessÃ¡ria para as funÃ§Ãµes de IA)
GEMINI_API_KEY=

# Supabase (Banco de Dados)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ConfiguraÃ§Ãµes de E-mail (Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

# Agenda (29/09/2026) - disparador dos alertas por e-mail (migracao 013)
# Segredo que o pg_cron do Supabase manda em "Authorization: Bearer ..." para
# /api/agenda/disparar. Minimo 16 caracteres; o MESMO valor vai no Vault (013).
# Sem ele a rota responde 503 e nenhum alerta sai. (CRON_SECRET tambem vale.)
AGENDA_CRON_SECRET=
# Endereco publico do app, usado no botao "Abrir a agenda" dos e-mails.
# Vazio = https://kpieng.jimpnexus.com
APP_URL=

# Indicador de uso (29/09/2026) - chip "BD x%" do Edson (migracoes 014 e 015).
# Todas opcionais: vazias = o confirmado em 29/09 (Supabase FREE, Vercel HOBBY).
# So no servidor (nunca VITE_). Variavel nova so vale depois de um Redeploy.
# Limite do banco em MB (FREE = 500; se passar a PRO, o que vale e o disco).
INFRA_DB_LIMITE_MB=
# Plano do Supabase e da Vercel (free/pro, hobby/pro): muda os limites mostrados.
INFRA_PLANO_SUPABASE=
INFRA_PLANO_VERCEL=
# % do banco a partir do qual sai o e-mail diario ao Edson (padrao 80).
# O alerta usa o MESMO AGENDA_CRON_SECRET (a 015 chama /api/infra/verificar).
INFRA_ALERTA_PCT=
